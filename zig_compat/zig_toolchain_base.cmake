set(CMAKE_SYSTEM_NAME ${ZIG_SYSTEM_NAME})
set(CMAKE_SYSTEM_PROCESSOR ${ZIG_SYSTEM_PROCESSOR})

if(DEFINED ZIG_SHIM_EXTENSION)
else()
    if(CMAKE_HOST_WIN32)
        set(ZIG_SHIM_EXTENSION .bat)
    else()
        set(ZIG_SHIM_EXTENSION .sh)
    endif()
endif()

set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/shims/zig_cc${ZIG_SHIM_EXTENSION}")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/shims/zig_c++${ZIG_SHIM_EXTENSION}")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/shims/zig_ar${ZIG_SHIM_EXTENSION}")
set(CMAKE_LINKER "${CMAKE_CURRENT_LIST_DIR}/shims/zig_ld.lld${ZIG_SHIM_EXTENSION}")
set(CMAKE_DLLTOOL "${CMAKE_CURRENT_LIST_DIR}/shims/zig_dlltool${ZIG_SHIM_EXTENSION}")
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/shims/zig_ranlib${ZIG_SHIM_EXTENSION}")
set(CMAKE_OBJCOPY  "${CMAKE_CURRENT_LIST_DIR}/shims/zig_objcopy${ZIG_SHIM_EXTENSION}")
set(CMAKE_RC_COMPILER "${CMAKE_CURRENT_LIST_DIR}/shims/zig_rc${ZIG_SHIM_EXTENSION}")

set(CMAKE_C_FLAGS "-target ${ZIG_TARGET}")
set(CMAKE_CXX_FLAGS "-target ${ZIG_TARGET}")

set(CMAKE_C_COMPILER_WORKS TRUE)
set(CMAKE_CXX_COMPILER_WORKS TRUE)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)